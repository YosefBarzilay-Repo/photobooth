{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Echo",
  "version": "1.0.0",
  "identifier": "com.sivyor.echo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build:static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Echo Main",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the Echo desktop window capabilities",
  "windows": [
    "main",
    "slideshow",
    "gallery"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "dialog:default"
  ]
}
